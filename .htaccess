# ── Gzip Compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Cache Control ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # PHP pages — no caching
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Images — 7 day cache
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>

  # CSS / JS — 7 day cache (bundle.min.js filename is static; update if contents change)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.php

RewriteEngine On
# ── WebP auto-serve: serve .webp instead of .jpg/.png when browser supports it and file exists ──
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
RewriteRule ^(images/.+)\.(jpe?g|png)$ /$1.webp [T=image/webp,L,NC]

# ── Sitemap ───────────────────────────────────────────────────────────────────
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
# ── Two-part player/event URLs ───────────────────────────────────────────────
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)$ go.php?slug=$1&v=$2 [L,QSA,NC]
# ── Custom Redirects ──────────────────────────────────────────────────────────
RewriteRule ^collins-nessa$ go.php?slug=collins-nessa&v=56ed5e [L,QSA,NC]
RewriteRule ^collins-nessa/([a-z0-9-]+)$ go.php?slug=collins-nessa&v=$1 [L,QSA,NC]
# ── Player / catch-all (slugs resolved in go.php via DB) ─────────────────────
RewriteRule ^([a-z0-9-]+)$ go.php?slug=$1&v=56ed5e [L,QSA,NC]
