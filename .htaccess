# ── Cache Control ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # PHP pages — no caching
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Images — short cache (5 minutes), must revalidate
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>

  # CSS / JS — short cache (5 minutes), must revalidate
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.php

RewriteEngine On
# ── Sitemap ───────────────────────────────────────────────────────────────────
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
# ── Two-part player/event URLs ───────────────────────────────────────────────
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)$ go.php?slug=$1&v=$2 [L,QSA,NC]
# ── Custom Redirects ──────────────────────────────────────────────────────────
RewriteRule ^collins-nessa$ go.php?slug=collins-nessa&v=56ed5e [L,QSA,NC]
RewriteRule ^collins-nessa/([a-z0-9-]+)$ go.php?slug=collins-nessa&v=$1 [L,QSA,NC]
# ── Player / catch-all (slugs resolved in go.php via DB) ─────────────────────
RewriteRule ^([a-z0-9-]+)$ go.php?slug=$1&v=56ed5e [L,QSA,NC]
